%%{init: {"flowchart": {"padding": 4, "nodeSpacing": 20, "rankSpacing": 9, "subGraphTitleMargin": {"top": 0, "bottom": 14}}}}%%
flowchart TB
    subgraph ConvLayers["Convolutional Layers"]
        direction TB
        subgraph ConvA[" "]
            direction LR
            I["Input<br/>1 × 28 × 28<br/>Grayscale MNIST"]
            C1["Conv2d: 1→32<br/>kernel: 3×3<br/>32 × 26 × 26"]
            R1["ReLU"]

            I --> C1 --> R1
        end
        subgraph ConvB[" "]
            direction LR
            C2["Conv2d: 32→64<br/>kernel: 3×3<br/>64 × 24 × 24"]
            R2["ReLU"]
            P2["MaxPool2d<br/>2×2<br/>64 × 12 × 12"]
            F["Flatten<br/>9216 features"]

            C2 --> R2 --> P2 --> F
        end
        ConvA --> ConvB
    end

    subgraph FCLayers["Fully Connected<br/>Classification"]
        direction LR
        FC1L["Linear<br/>9216 → 128"]
        R3["ReLU"]
        FC2L["Linear<br/>128 → 10"]
        LS["Log-Softmax"]
        O["Output<br/>10 classes<br/>Digits 0-9"]

        FC1L --> R3 --> FC2L --> LS --> O
    end

    ConvLayers ----> FCLayers

